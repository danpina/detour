# Copy to .env.local and fill in. Never commit .env.local.
# These keys are used ONLY by /tools on your computer, never shipped in the app.

# Card drafting + fact-checking
ANTHROPIC_API_KEY=
CONTENT_MODEL=

# Image search (Wikimedia, NASA and museum APIs need no key)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Image generation fallback (one provider)
IMAGE_GEN_PROVIDER=          # e.g. openai | google
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=

# Web app (public, safe to ship)
VITE_TELEMETRYDECK_APP_ID=
